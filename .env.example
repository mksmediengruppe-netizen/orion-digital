# ARCANE 4.0 — Environment Configuration Example
# Copy this file to .env and fill in your values

# --- Server ---
ARCANE_ENV=production
ARCANE_DEBUG=false
ARCANE_HOST=0.0.0.0
ARCANE_PORT=8901
ARCANE_DOMAIN=your-server-ip-or-domain

# --- Strategy ---
DEFAULT_MODEL_STRATEGY=arcane4
DEFAULT_BUDGET_LIMIT=10.0

# --- OpenRouter API (required for AI models) ---
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Manus API (required for browser/SSH execution) ---
# Get your key at: https://manus.im
MANUS_API_KEY=your-manus-key-here
MANUS_API_URL=https://api.manus.im

# --- Anthropic (optional, direct API) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- PostgreSQL (optional, not used in MVP) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=arcane
POSTGRES_USER=arcane
POSTGRES_PASSWORD=your-db-password
DATABASE_URL=

# --- CORS ---
CORS_ORIGINS=*
